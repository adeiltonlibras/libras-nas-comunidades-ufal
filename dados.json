<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Painel Admin — Libras nas Comunidades</title>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
  /* ============================================================
     VARIÁVEIS DE COR
     ============================================================ */
  :root{
    --primaria:    #2563EB;
    --destaque:    #F97316;
    --destaque-2:  #FB923C;
    --verde:       #16A34A;
    --vermelho:    #DC2626;
    --amarelo:     #FACC15;
    --roxo:        #7C3AED;
    --navy:        #0F172A;
    --navy-2:      #1E3A8A;
    --texto:       #0F172A;
    --texto-suave: #64748B;
    --borda:       #E2E8F0;
    --fundo:       #F8FAFC;
    --branco:      #FFFFFF;
    --raio:        14px;
    --sombra:      0 4px 20px rgba(15,23,42,.06);
  }
  *{font-family:'Plus Jakarta Sans',sans-serif;box-sizing:border-box;margin:0;padding:0;}
  body{background:var(--fundo);color:var(--texto);line-height:1.5;padding:0 0 60px;}

  /* ============================================================
     TOPBAR
     ============================================================ */
  .topbar{
    background:linear-gradient(135deg,#0F172A,#1E3A8A);
    color:#fff;
    padding:16px 28px;
    display:flex;
    justify-content:space-between;
    align-items:center;
    flex-wrap:wrap;
    gap:14px;
    box-shadow:0 4px 20px rgba(11,37,69,.25);
    position:sticky;
    top:0;
    z-index:100;
  }
  .brand{display:flex;align-items:center;gap:14px;}
  .brand .ic{
    width:44px;height:44px;
    border-radius:12px;
    background:linear-gradient(135deg,var(--destaque),var(--amarelo));
    display:flex;align-items:center;justify-content:center;
    font-size:1.3rem;
    box-shadow:0 6px 20px rgba(249,115,22,.35);
  }
  .brand .txt .title{font-weight:800;font-size:.95rem;letter-spacing:-.2px;}
  .brand .txt .sub{font-size:.66rem;color:#94A3B8;font-weight:600;letter-spacing:1px;text-transform:uppercase;margin-top:2px;}
  .topbar-actions{display:flex;gap:8px;flex-wrap:wrap;}

  /* ============================================================
     BOTÕES
     ============================================================ */
  .btn{
    border:none;
    border-radius:10px;
    padding:10px 18px;
    font-size:.78rem;
    font-weight:800;
    cursor:pointer;
    font-family:inherit;
    display:inline-flex;
    align-items:center;
    gap:8px;
    transition:all .2s;
    letter-spacing:.2px;
  }
  .btn:hover{transform:translateY(-1px);}
  .btn.laranja{background:linear-gradient(135deg,var(--destaque),var(--destaque-2));color:#fff;box-shadow:0 4px 12px rgba(249,115,22,.3);}
  .btn.verde{background:var(--verde);color:#fff;box-shadow:0 4px 12px rgba(22,163,74,.3);}
  .btn.azul{background:var(--primaria);color:#fff;box-shadow:0 4px 12px rgba(37,99,235,.3);}
  .btn.vermelho{background:var(--vermelho);color:#fff;}
  .btn.cinza{background:#475569;color:#fff;}
  .btn.outline{background:transparent;color:#fff;border:1.5px solid rgba(255,255,255,.3);}
  .btn.outline:hover{background:rgba(255,255,255,.1);}
  .btn.pequeno{padding:7px 13px;font-size:.72rem;border-radius:8px;}

  /* ============================================================
     CONTAINER
     ============================================================ */
  .container{max-width:1300px;margin:0 auto;padding:24px 20px;}

  /* ============================================================
     ABAS
     ============================================================ */
  .tabs{
    display:flex;
    gap:6px;
    background:#fff;
    padding:6px;
    border-radius:var(--raio);
    box-shadow:var(--sombra);
    margin-bottom:22px;
    overflow-x:auto;
    border:1px solid var(--borda);
  }
  .tab{
    border:none;
    background:transparent;
    color:var(--texto-suave);
    padding:11px 20px;
    border-radius:10px;
    font-size:.78rem;
    font-weight:800;
    cursor:pointer;
    font-family:inherit;
    white-space:nowrap;
    transition:all .15s;
  }
  .tab:hover{background:#F1F5F9;color:var(--texto);}
  .tab.active{
    background:linear-gradient(135deg,var(--navy),var(--navy-2));
    color:#fff;
    box-shadow:0 4px 12px rgba(11,37,69,.25);
  }

  /* ============================================================
     PAINÉIS
     ============================================================ */
  .painel{display:none;}
  .painel.active{display:block;}

  /* ============================================================
     CARDS
     ============================================================ */
  .card{
    background:#fff;
    border:1px solid var(--borda);
    border-radius:var(--raio);
    padding:24px 26px;
    box-shadow:var(--sombra);
    margin-bottom:20px;
  }
  .card h3{
    font-size:.92rem;
    font-weight:800;
    color:var(--texto);
    padding-bottom:12px;
    border-bottom:2px solid var(--destaque);
    margin-bottom:20px;
    display:flex;
    align-items:center;
    gap:10px;
  }
  .card h3 .ic{
    width:32px;height:32px;
    border-radius:9px;
    background:linear-gradient(135deg,var(--navy),var(--navy-2));
    color:#fff;
    display:flex;align-items:center;justify-content:center;
    font-size:.95rem;
  }
  .help{font-size:.75rem;color:var(--texto-suave);margin-bottom:16px;line-height:1.55;}

  /* ============================================================
     FORMULÁRIOS
     ============================================================ */
  .form-grid{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(230px,1fr));
    gap:14px 20px;
  }
  .field{display:flex;flex-direction:column;gap:6px;}
  .field label{
    font-size:.68rem;
    font-weight:800;
    letter-spacing:.6px;
    color:var(--navy-2);
    text-transform:uppercase;
  }
  .field input,
  .field select,
  .field textarea{
    font-family:inherit;
    font-size:.84rem;
    padding:11px 13px;
    border:1.5px solid var(--borda);
    border-radius:10px;
    background:#FBFDFF;
    color:var(--texto);
    width:100%;
    transition:all .15s;
  }
  .field input:focus,
  .field select:focus,
  .field textarea:focus{
    outline:none;
    border-color:var(--destaque);
    box-shadow:0 0 0 4px rgba(249,115,22,.12);
    background:#fff;
  }
  .field textarea{
    resize:vertical;
    min-height:80px;
    line-height:1.55;
    font-family:'Courier New',monospace;
    font-size:.78rem;
  }
  .field.full{grid-column:1/-1;}

  /* ============================================================
     TABELAS
     ============================================================ */
  .table-wrap{
    overflow-x:auto;
    border-radius:12px;
    border:1px solid var(--borda);
    background:#fff;
  }
  .data-table{
    width:100%;
    border-collapse:collapse;
    font-size:.76rem;
    min-width:900px;
  }
  .data-table th{
    background:var(--navy);
    color:#fff;
    text-align:left;
    padding:11px 12px;
    font-size:.62rem;
    font-weight:800;
    letter-spacing:.6px;
    text-transform:uppercase;
    border:1px solid var(--navy);
    white-space:nowrap;
  }
  .data-table td{
    border:1px solid var(--borda);
    padding:6px 8px;
    background:#FBFDFF;
    vertical-align:middle;
  }
  .data-table input,
  .data-table select{
    font-family:inherit;
    font-size:.76rem;
    padding:7px 9px;
    border:1px solid #CBD5E1;
    border-radius:7px;
    background:#fff;
    width:100%;
  }
  .data-table input:focus,
  .data-table select:focus{
    outline:none;
    border-color:var(--destaque);
    box-shadow:0 0 0 3px rgba(249,115,22,.15);
  }
  .row-del{
    background:transparent;
    border:none;
    color:var(--vermelho);
    font-size:1rem;
    cursor:pointer;
    padding:4px 7px;
    border-radius:6px;
    font-weight:800;
  }
  .row-del:hover{background:#FEE2E2;}
  .add-row{margin-top:14px;display:flex;gap:10px;flex-wrap:wrap;}

  /* ============================================================
     PUBLISH BOX
     ============================================================ */
  .publish-box{
    background:linear-gradient(135deg,#16A34A 0%,#0F172A 100%);
    color:#fff;
    border-radius:var(--raio);
    padding:26px 28px;
    margin-bottom:22px;
    box-shadow:0 12px 40px rgba(11,37,69,.25);
  }
  .publish-box h3{
    font-size:1rem;
    font-weight:800;
    margin-bottom:10px;
    color:#fff;
    padding-bottom:0;
    border-bottom:none;
    display:flex;
    align-items:center;
    gap:10px;
  }
  .publish-box p{font-size:.8rem;color:#D1FAE5;margin-bottom:18px;line-height:1.6;}
  .publish-box .btn-branco{
    background:#fff;
    color:var(--verde);
    padding:14px 28px;
    font-size:.86rem;
    font-weight:800;
    box-shadow:0 6px 20px rgba(0,0,0,.25);
    border:none;
    border-radius:10px;
    cursor:pointer;
    font-family:inherit;
    display:inline-flex;
    align-items:center;
    gap:8px;
    transition:all .2s;
  }
  .publish-box .btn-branco:hover{transform:translateY(-2px);}
  .info-pub{
    margin-top:16px;
    background:rgba(255,255,255,.1);
    border-radius:10px;
    padding:16px 20px;
    font-size:.74rem;
    line-height:1.8;
    color:#D1FAE5;
  }

  /* ============================================================
     LISTA DE PÁGINAS
     ============================================================ */
  .paginas-lista{display:flex;flex-direction:column;gap:14px;margin-top:16px;}
  .pagina-item{
    background:#FBFDFF;
    border:1px solid var(--borda);
    border-radius:14px;
    padding:18px 20px;
    display:grid;
    grid-template-columns:64px 1fr auto;
    gap:18px;
    align-items:center;
    transition:all .15s;
  }
  .pagina-item:hover{
    border-color:var(--primaria);
    box-shadow:0 4px 16px rgba(37,99,235,.08);
  }
  .pagina-item .icone{
    width:56px;height:56px;
    border-radius:14px;
    background:linear-gradient(135deg,#EFF6FF,#DBEAFE);
    display:flex;align-items:center;justify-content:center;
    font-size:1.5rem;
  }
  .pagina-item .info h4{
    font-size:.92rem;
    font-weight:800;
    color:var(--texto);
    margin-bottom:4px;
    display:flex;
    align-items:center;
    gap:8px;
  }
  .pagina-item .info .slug{
    font-size:.7rem;
    color:var(--texto-suave);
    font-family:'Courier New',monospace;
    background:#F1F5F9;
    padding:3px 8px;
    border-radius:5px;
    display:inline-block;
    margin-bottom:5px;
  }
  .pagina-item .info .desc{
    font-size:.78rem;
    color:#475569;
    line-height:1.5;
  }
  .pagina-item .acoes{display:flex;gap:6px;flex-wrap:wrap;}

  /* ============================================================
     STATS
     ============================================================ */
  .stats-grid{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(150px,1fr));
    gap:14px;
  }
  .stat-card{
    background:#F8FAFC;
    border:1px solid var(--borda);
    border-radius:12px;
    padding:16px 18px;
    border-left:4px solid var(--primaria);
  }
  .stat-card .label{
    font-size:.65rem;
    font-weight:800;
    letter-spacing:1px;
    color:var(--texto-suave);
    text-transform:uppercase;
    margin-bottom:8px;
  }
  .stat-card .valor{
    font-size:1.7rem;
    font-weight:800;
    color:var(--navy);
    line-height:1;
  }

  /* ============================================================
     MODAL
     ============================================================ */
  .overlay{
    display:none;
    position:fixed;
    inset:0;
    background:rgba(15,23,42,.7);
    backdrop-filter:blur(4px);
    z-index:500;
    align-items:center;
    justify-content:center;
    padding:20px;
  }
  .overlay.show{display:flex;}
  .modal{
    background:#fff;
    border-radius:20px;
    padding:28px;
    max-width:780px;
    width:100%;
    max-height:90vh;
    overflow-y:auto;
    box-shadow:0 30px 80px rgba(0,0,0,.4);
  }
  .modal h3{
    font-size:1.05rem;
    font-weight:800;
    color:var(--texto);
    margin-bottom:20px;
    padding-bottom:16px;
    border-bottom:2px solid var(--destaque);
  }
  .modal-acoes{
    display:flex;
    justify-content:flex-end;
    gap:10px;
    margin-top:24px;
    padding-top:20px;
    border-top:1px solid var(--borda);
  }

  /* ============================================================
     TOAST
     ============================================================ */
  .toast{
    position:fixed;
    bottom:28px;
    left:50%;
    transform:translateX(-50%) translateY(100px);
    background:var(--navy);
    color:#fff;
    padding:14px 26px;
    border-radius:12px;
    font-size:.83rem;
    font-weight:700;
    box-shadow:0 10px 30px rgba(0,0,0,.35);
    opacity:0;
    transition:all .3s cubic-bezier(.4,0,.2,1);
    z-index:9999;
    pointer-events:none;
    max-width:90vw;
    text-align:center;
  }
  .toast.show{opacity:1;transform:translateX(-50%) translateY(0);}

  /* ============================================================
     RESPONSIVO
     ============================================================ */
  @media (max-width:700px){
    .container{padding:16px 12px;}
    .card{padding:18px;}
    .pagina-item{grid-template-columns:44px 1fr;gap:14px;}
    .pagina-item .acoes{grid-column:1/-1;justify-content:flex-end;}
    .topbar{padding:12px 16px;}
    .topbar-actions{width:100%;justify-content:flex-start;}
  }
</style>
</head>
<body>

<!-- ============================================================
     TOPBAR
     ============================================================ -->
<div class="topbar">
  <div class="brand">
    <div class="ic">🤟</div>
    <div class="txt">
      <div class="title">Painel Admin</div>
      <div class="sub">Libras nas Comunidades</div>
    </div>
  </div>
  <div class="topbar-actions">
    <button class="btn outline pequeno" onclick="carregarDados()">🔄 Recarregar</button>
    <button class="btn verde pequeno" onclick="publicar()">📤 Publicar</button>
  </div>
</div>

<div class="container">

  <!-- ============================================================
       ABAS
       ============================================================ -->
  <div class="tabs">
    <button class="tab active" data-tab="inicio">🏠 Início</button>
    <button class="tab" data-tab="site">⚙️ Site</button>
    <button class="tab" data-tab="home">🏡 Home</button>
    <button class="tab" data-tab="eventos">📅 Eventos</button>
    <button class="tab" data-tab="paginas">📄 Páginas</button>
    <button class="tab" data-tab="conteudo">📖 Conteúdo</button>
    <button class="tab" data-tab="sigaa">🔗 SIGAA</button>
  </div>

  <!-- ============================================================
       ABA INÍCIO
       ============================================================ -->
  <div class="painel active" id="p-inicio">
    <div class="publish-box">
      <h3>📤 Publicar alterações</h3>
      <p>Ao clicar em <b>PUBLICAR AGORA</b>, o arquivo <b>dados.json</b> será baixado com todas as alterações. Depois, suba no GitHub substituindo o antigo.</p>
      <button class="btn-branco" onclick="publicar()">📤 PUBLICAR AGORA</button>
      <div class="info-pub">
        <b>Passo a passo:</b><br>
        1. Clique em PUBLICAR → baixa <b>dados.json</b><br>
        2. Acesse <b>github.com/adeiltonlibras/libras-nas-comunidades-ufal</b><br>
        3. Clique em <b>dados.json</b> → ícone ✏️<br>
        4. Apague tudo, cole o novo conteúdo, commit<br>
        5. Alunos veem atualizado em ~30 segundos
      </div>
    </div>

    <div class="card">
      <h3><span class="ic">📊</span> Estatísticas</h3>
      <div class="stats-grid" id="stats"></div>
    </div>
  </div>

  <!-- ============================================================
       ABA SITE
       ============================================================ -->
  <div class="painel" id="p-site">
    <div class="card">
      <h3><span class="ic">🏛️</span> Identificação do Curso</h3>
      <div class="form-grid">
        <div class="field"><label>Nome do Projeto</label><input id="f_projeto"></div>
        <div class="field"><label>Nome do Curso</label><input id="f_curso"></div>
        <div class="field"><label>Subtítulo</label><input id="f_subtitulo"></div>
        <div class="field full"><label>Local</label><input id="f_local"></div>
        <div class="field"><label>Período</label><input id="f_periodo"></div>
        <div class="field"><label>Dias das aulas</label><input id="f_aulas"></div>
        <div class="field"><label>Horário</label><input id="f_horario"></div>
        <div class="field"><label>Carga-horária (h)</label><input type="number" id="f_carga"></div>
      </div>
    </div>
  </div>

  <!-- ============================================================
       ABA HOME
       ============================================================ -->
  <div class="painel" id="p-home">
    <div class="card">
      <h3><span class="ic">🏡</span> Página Inicial</h3>
      <p class="help">Textos que aparecem na home do site.</p>
      <div class="form-grid">
        <div class="field full"><label>Título da Home</label><input id="f_home_titulo"></div>
        <div class="field full"><label>Subtítulo da Home</label><input id="f_home_subtitulo"></div>
        <div class="field full"><label>Texto de apresentação</label><textarea id="f_home_descricao" style="font-family:inherit;"></textarea></div>
      </div>
    </div>
  </div>

  <!-- ============================================================
       ABA EVENTOS
       ============================================================ -->
  <div class="painel" id="p-eventos">
    <div class="card">
      <h3><span class="ic">📅</span> Eventos do Calendário</h3>
      <p class="help">Adicione, edite ou exclua eventos. Alterações entram no site após publicar.</p>
      <div class="table-wrap">
        <table class="data-table">
          <thead>
            <tr>
              <th style="width:130px">Data</th>
              <th style="width:180px">Tipo</th>
              <th style="width:110px">Rótulo</th>
              <th>Descrição</th>
              <th style="width:110px">Horário</th>
              <th style="width:80px">Carga (h)</th>
              <th style="width:50px"></th>
            </tr>
          </thead>
          <tbody id="corpo-eventos"></tbody>
        </table>
      </div>
      <div class="add-row">
        <button class="btn verde pequeno" onclick="addEvento()">➕ Adicionar evento</button>
      </div>
    </div>
  </div>

  <!-- ============================================================
       ABA PÁGINAS
       ============================================================ -->
  <div class="painel" id="p-paginas">
    <div class="card">
      <h3><span class="ic">📄</span> Páginas do Site</h3>
      <p class="help">Crie e gerencie páginas. Cada página aparece no menu e como card na home. Tipos: <b>calendário</b> (página especial) ou <b>HTML</b> (conteúdo livre).</p>
      <div class="add-row" style="margin-top:0;margin-bottom:16px;">
        <button class="btn laranja pequeno" onclick="abrirNovaPagina()">➕ Criar nova página</button>
      </div>
      <div class="paginas-lista" id="lista-paginas"></div>
    </div>
  </div>

  <!-- ============================================================
       ABA CONTEÚDO
       ============================================================ -->
  <div class="painel" id="p-conteudo">
    <div class="card">
      <h3><span class="ic">📖</span> Conteúdo Programático</h3>
      <p class="help">Um item por linha. Aparece na página do calendário.</p>
      <div class="field full">
        <textarea id="f_conteudo" style="min-height:240px;font-family:inherit;"></textarea>
      </div>
    </div>
  </div>

  <!-- ============================================================
       ABA SIGAA
       ============================================================ -->
  <div class="painel" id="p-sigaa">
    <div class="card">
      <h3><span class="ic">🔗</span> Cadastro no SIGAA/UFAL</h3>
      <div class="form-grid">
        <div class="field full"><label>Título da seção</label><input id="f_inscTitulo"></div>
        <div class="field full"><label>Texto de apoio</label><textarea id="f_inscTexto" style="font-family:inherit;"></textarea></div>
        <div class="field"><label>Link do cadastro SIGAA</label><input id="f_linkCadastro"></div>
        <div class="field"><label>Link do vídeo tutorial</label><input id="f_linkVideo"></div>
      </div>
    </div>
  </div>

</div>

<!-- ============================================================
     MODAL DE PÁGINA
     ============================================================ -->
<div class="overlay" id="overlay">
  <div class="modal">
    <h3 id="modal-titulo">📄 Nova Página</h3>
    <div class="form-grid">
      <div class="field">
        <label>Slug (URL)</label>
        <input id="pg_slug" placeholder="ex: material">
      </div>
      <div class="field">
        <label>Ícone (emoji)</label>
        <input id="pg_icone" placeholder="📚" maxlength="4">
      </div>
      <div class="field full">
        <label>Título</label>
        <input id="pg_titulo" placeholder="Ex: Material de Apoio">
      </div>
      <div class="field full">
        <label>Descrição (para o card e menu)</label>
        <input id="pg_descricao" placeholder="Breve descrição">
      </div>
      <div class="field">
        <label>Tipo</label>
        <select id="pg_tipo">
          <option value="html">HTML (conteúdo livre)</option>
          <option value="calendario">Calendário (página especial)</option>
        </select>
      </div>
      <div class="field">
        <label>Ordem no menu</label>
        <input type="number" id="pg_ordem" value="99" min="0">
      </div>
      <div class="field">
        <label>Publicada?</label>
        <select id="pg_publicada">
          <option value="true">Sim</option>
          <option value="false">Não (rascunho)</option>
        </select>
      </div>
      <div class="field full" id="pg_html_wrap">
        <label>Conteúdo HTML</label>
        <textarea id="pg_html" style="min-height:280px;" placeholder="<h2>Título</h2><p>Texto...</p>"></textarea>
      </div>
    </div>
    <div class="modal-acoes">
      <button class="btn cinza pequeno" onclick="fecharModal()">Cancelar</button>
      <button class="btn verde pequeno" onclick="salvarPagina()">💾 Salvar</button>
    </div>
  </div>
</div>

<div class="toast" id="toast"></div>

<!-- ============================================================
     JAVASCRIPT
     ============================================================ -->
<script>
// URL do dados.json no GitHub (ajuste se mudar o repositório)
const URL_DADOS = 'https://adeiltonlibras.github.io/libras-nas-comunidades-ufal/dados.json';

// ============================================================
// TIPOS DE EVENTO
// ============================================================
const TIPOS = {
  inicio:    {label:'🟢 Início',              cor:'#16A34A'},
  aula:      {label:'🟦 Aula Presencial',     cor:'#2563EB'},
  meet:      {label:'🟪 Assíncrona + Meet',   cor:'#7C3AED'},
  ativ:      {label:'📝 Ativ. Complementar',  cor:'#0D9488'},
  avaliacao: {label:'🟠 Avaliação',           cor:'#F97316'},
  recesso:   {label:'🟨 Recesso',             cor:'#FACC15'},
  feriado:   {label:'⚫ Feriado',              cor:'#475569'},
  cancelado: {label:'🔴 Cancelado',           cor:'#DC2626'},
  fim:       {label:'🔵 Encerramento',        cor:'#38BDF8'}
};

// ============================================================
// DADOS PADRÃO (usados se não conseguir carregar do GitHub)
// ============================================================
const DADOS_PADRAO = {
  site:{
    projeto:'LIBRAS NAS COMUNIDADES',
    curso:'CURSO BÁSICO DE LIBRAS – NÍVEL I',
    subtitulo:'Projeto de Extensão Universitária · UFAL',
    local:'AD Benedito Bentes 3 – Conjunto Frei Damião, Maceió/AL',
    periodo:'17/10/2026 a 23/01/2027',
    aulas:'aos sábados',
    horario:'15h às 17h30',
    carga:40,
    inscTitulo:'CADASTRO NO SIGAA/UFAL – EXTENSÃO',
    inscTexto:'Para participar do curso, realize seu cadastro no SIGAA/UFAL – Extensão.',
    linkCadastro:'https://sigaa.sig.ufal.br/sigaa/public/extensao/loginCursosEventosExtensao.jsf',
    linkVideo:'https://youtu.be/WtgErX91gs0'
  },
  home:{
    titulo:'Libras nas Comunidades',
    subtitulo:'Bem-vindo(a) ao portal do curso',
    descricao:'Curso Básico de Libras – Nível I, promovido pela UFAL em parceria com a Assembleia de Deus em Benedito Bentes 3.'
  },
  conteudo:'Vocabulário básico\nAlfabeto manual\nNúmeros\nDatilologia\nCumprimentos\nVerbos\nCalendário\nSemana\nMeses\nAno\nHoras\nCores',
  eventos:[],
  paginas:[]
};

// ============================================================
// EVENTOS PADRÃO (usados no primeiro carregamento)
// ============================================================
const EVENTOS_PADRAO = [
  {data:'2026-10-17', tipo:'inicio', rotulo:'Início',     descricao:'Aula 01 · Introdução à Libras',                     horario:'15h às 17h30', carga:2.5},
  {data:'2026-10-24', tipo:'aula',   rotulo:'Aula',       descricao:'Aula 02 · Alfabeto manual',                          horario:'15h às 17h30', carga:2.5},
  {data:'2026-10-31', tipo:'meet',   rotulo:'Meet',       descricao:'Atividade assíncrona + Google Meet',                 horario:'A definir',    carga:2.5},
  {data:'2026-11-07', tipo:'aula',   rotulo:'Aula',       descricao:'Aula 03 · Números e horários',                       horario:'15h às 17h30', carga:2.5},
  {data:'2026-11-14', tipo:'aula',   rotulo:'Aula',       descricao:'Aula 04 · Saudações',                                horario:'15h às 17h30', carga:2.5},
  {data:'2026-11-21', tipo:'aula',   rotulo:'Aula',       descricao:'Aula 05 · Família e relações',                       horario:'15h às 17h30', carga:2.5},
  {data:'2026-11-28', tipo:'meet',   rotulo:'Meet',       descricao:'Atividade assíncrona + Google Meet',                 horario:'A definir',    carga:2.5},
  {data:'2026-12-05', tipo:'aula',   rotulo:'Aula',       descricao:'Aula 06 · Cores e objetos',                          horario:'15h às 17h30', carga:2.5},
  {data:'2026-12-12', tipo:'aula',   rotulo:'Aula',       descricao:'Aula 07 · Verbos e frases',                          horario:'15h às 17h30', carga:2.5},
  {data:'2026-12-19', tipo:'aula',   rotulo:'Aula',       descricao:'Aula 08 · Perguntas e respostas',                    horario:'15h às 17h30', carga:2.5},
  {data:'2026-12-26', tipo:'meet',   rotulo:'Meet',       descricao:'Atividade assíncrona + Google Meet',                 horario:'A definir',    carga:2.5},
  {data:'2027-01-02', tipo:'aula',   rotulo:'Aula',       descricao:'Aula 09 · Estrutura das frases',                     horario:'15h às 17h30', carga:2.5},
  {data:'2027-01-09', tipo:'aula',   rotulo:'Aula',       descricao:'Aula 10 · Expressões não manuais',                   horario:'15h às 17h30', carga:2.5},
  {data:'2027-01-16', tipo:'aula',   rotulo:'Aula',       descricao:'Aula 11 · Situações comunicativas',                  horario:'15h às 17h30', carga:2.5},
  {data:'2027-01-23', tipo:'fim',    rotulo:'Encerramento',descricao:'Aula 12 · Prática integrada',                       horario:'15h às 17h30', carga:2.5}
];

// ============================================================
// ESTADO GLOBAL
// ============================================================
let D = JSON.parse(JSON.stringify(DADOS_PADRAO));
let paginaEmEdicao = null;

// ============================================================
// UTILIDADES
// ============================================================
function toast(msg, ms){
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.classList.add('show');
  clearTimeout(t._t);
  t._t = setTimeout(() => t.classList.remove('show'), ms || 2600);
}

// ============================================================
// NAVEGAÇÃO POR ABAS
// ============================================================
document.querySelectorAll('.tab').forEach(tab => {
  tab.addEventListener('click', () => {
    document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
    tab.classList.add('active');
    document.querySelectorAll('.painel').forEach(p => p.classList.remove('active'));
    document.getElementById('p-' + tab.dataset.tab).classList.add('active');
    window.scrollTo({top:0, behavior:'smooth'});
  });
});

// ============================================================
// CARREGAR DADOS DO GITHUB
// ============================================================
async function carregarDados(){
  try{
    const r = await fetch(URL_DADOS + '?t=' + Date.now());
    if(r.ok){
      const json = await r.json();
      D = Object.assign(JSON.parse(JSON.stringify(DADOS_PADRAO)), json);
      if(!Array.isArray(D.eventos)) D.eventos = [];
      if(!Array.isArray(D.paginas)) D.paginas = [];
      toast('✅ Dados carregados do GitHub');
    } else {
      throw new Error('HTTP ' + r.status);
    }
  }catch(e){
    console.warn(e);
    toast('⚠️ Não foi possível carregar do GitHub. Usando dados padrão.', 3500);
    if(!D.eventos.length) D.eventos = EVENTOS_PADRAO.map(x => ({...x}));
  }
  renderTudo();
}

// ============================================================
// RENDERIZAR TUDO
// ============================================================
function renderTudo(){
  renderSiteForm();
  renderHomeForm();
  renderEventos();
  renderPaginas();
  renderConteudo();
  renderSigaa();
  renderStats();
}

// ============================================================
// FORMULÁRIO SITE
// ============================================================
function renderSiteForm(){
  const S = D.site;
  const mapa = {
    f_projeto:'projeto', f_curso:'curso', f_subtitulo:'subtitulo', f_local:'local',
    f_periodo:'periodo', f_aulas:'aulas', f_horario:'horario', f_carga:'carga'
  };
  Object.entries(mapa).forEach(([id, k]) => {
    const el = document.getElementById(id);
    if(el){
      el.value = S[k] ?? '';
      el.oninput = () => { S[k] = el.type === 'number' ? Number(el.value) : el.value; };
    }
  });
}

// ============================================================
// FORMULÁRIO HOME
// ============================================================
function renderHomeForm(){
  const H = D.home;
  const mapa = { f_home_titulo:'titulo', f_home_subtitulo:'subtitulo', f_home_descricao:'descricao' };
  Object.entries(mapa).forEach(([id, k]) => {
    const el = document.getElementById(id);
    if(el){
      el.value = H[k] ?? '';
      el.oninput = () => { H[k] = el.value; };
    }
  });
}

// ============================================================
// EVENTOS
// ============================================================
function renderEventos(){
  const corpo = document.getElementById('corpo-eventos');
  corpo.innerHTML = '';
  if(!D.eventos.length){
    corpo.innerHTML = `<tr><td colspan="7" style="text-align:center;color:#94A3B8;padding:22px;font-style:italic">Nenhum evento cadastrado.</td></tr>`;
    return;
  }
  D.eventos.slice().sort((a,b) => a.data.localeCompare(b.data)).forEach((ev) => {
    const tr = document.createElement('tr');

    // Data
    const tdData = document.createElement('td');
    const inp = document.createElement('input');
    inp.type = 'date'; inp.value = ev.data;
    inp.onchange = () => { ev.data = inp.value; };
    tdData.appendChild(inp); tr.appendChild(tdData);

    // Tipo
    const tdTipo = document.createElement('td');
    const sel = document.createElement('select');
    Object.entries(TIPOS).forEach(([k,v]) => {
      const o = document.createElement('option');
      o.value = k; o.textContent = v.label;
      if(k === ev.tipo) o.selected = true;
      sel.appendChild(o);
    });
    sel.onchange = () => { ev.tipo = sel.value; };
    tdTipo.appendChild(sel); tr.appendChild(tdTipo);

    // Rótulo
    const tdRot = document.createElement('td');
    const inpR = document.createElement('input');
    inpR.value = ev.rotulo || '';
    inpR.oninput = () => { ev.rotulo = inpR.value; };
    tdRot.appendChild(inpR); tr.appendChild(tdRot);

    // Descrição
    const tdDesc = document.createElement('td');
    const inpD = document.createElement('input');
    inpD.value = ev.descricao || '';
    inpD.oninput = () => { ev.descricao = inpD.value; };
    tdDesc.appendChild(inpD); tr.appendChild(tdDesc);

    // Horário
    const tdHor = document.createElement('td');
    const inpH = document.createElement('input');
    inpH.value = ev.horario || '';
    inpH.oninput = () => { ev.horario = inpH.value; };
    tdHor.appendChild(inpH); tr.appendChild(tdHor);

    // Carga
    const tdCarga = document.createElement('td');
    const inpC = document.createElement('input');
    inpC.type = 'number'; inpC.step = '0.5'; inpC.value = ev.carga || 0;
    inpC.oninput = () => { ev.carga = Number(inpC.value) || 0; };
    tdCarga.appendChild(inpC); tr.appendChild(tdCarga);

    // Ação
    const tdAcao = document.createElement('td');
    tdAcao.style.textAlign = 'center';
    const btn = document.createElement('button');
    btn.className = 'row-del'; btn.textContent = '✕';
    btn.onclick = () => {
      if(confirm('Excluir este evento?')){
        D.eventos = D.eventos.filter(x => x !== ev);
        renderEventos(); renderStats();
      }
    };
    tdAcao.appendChild(btn); tr.appendChild(tdAcao);

    corpo.appendChild(tr);
  });
}

function addEvento(){
  D.eventos.push({
    data: new Date().toISOString().slice(0,10),
    tipo:'aula', rotulo:'Aula', descricao:'',
    horario:'15h às 17h30', carga:2.5
  });
  renderEventos(); renderStats();
  toast('Evento adicionado.');
}

// ============================================================
// PÁGINAS
// ============================================================
function renderPaginas(){
  const lista = document.getElementById('lista-paginas');
  lista.innerHTML = '';
  if(!D.paginas.length){
    lista.innerHTML = '<p style="text-align:center;color:#94A3B8;padding:20px;font-style:italic;">Nenhuma página criada ainda.</p>';
    return;
  }
  D.paginas.slice().sort((a,b) => (a.ordem||99) - (b.ordem||99)).forEach((pg) => {
    const idx = D.paginas.indexOf(pg);
    const div = document.createElement('div');
    div.className = 'pagina-item';
    div.innerHTML = `
      <div class="icone">${pg.icone || '📄'}</div>
      <div class="info">
        <h4>
          ${pg.titulo}
          ${pg.publicada === false ? '<span style="background:#FEF3C7;color:#713F12;padding:2px 10px;border-radius:20px;font-size:.6rem;">RASCUNHO</span>' : ''}
        </h4>
        <div class="slug">/${pg.slug} · tipo: ${pg.tipo} · ordem: ${pg.ordem||99}</div>
        <div class="desc">${pg.descricao || ''}</div>
      </div>
      <div class="acoes">
        <button class="btn cinza pequeno" onclick="editarPagina(${idx})">✏️ Editar</button>
        <button class="btn vermelho pequeno" onclick="excluirPagina(${idx})">🗑️</button>
      </div>
    `;
    lista.appendChild(div);
  });
}

function abrirNovaPagina(){
  paginaEmEdicao = null;
  document.getElementById('modal-titulo').textContent = '📄 Nova Página';
  document.getElementById('pg_slug').value = '';
  document.getElementById('pg_icone').value = '📄';
  document.getElementById('pg_titulo').value = '';
  document.getElementById('pg_descricao').value = '';
  document.getElementById('pg_tipo').value = 'html';
  document.getElementById('pg_ordem').value = (D.paginas.length + 1);
  document.getElementById('pg_publicada').value = 'true';
  document.getElementById('pg_html').value = '<h2>Título</h2>\n<p>Escreva o conteúdo aqui.</p>';
  toggleHtmlWrap();
  document.getElementById('overlay').classList.add('show');
}

function editarPagina(idx){
  const pg = D.paginas[idx];
  paginaEmEdicao = idx;
  document.getElementById('modal-titulo').textContent = '✏️ Editar Página';
  document.getElementById('pg_slug').value = pg.slug || '';
  document.getElementById('pg_icone').value = pg.icone || '📄';
  document.getElementById('pg_titulo').value = pg.titulo || '';
  document.getElementById('pg_descricao').value = pg.descricao || '';
  document.getElementById('pg_tipo').value = pg.tipo || 'html';
  document.getElementById('pg_ordem').value = pg.ordem || 99;
  document.getElementById('pg_publicada').value = pg.publicada === false ? 'false' : 'true';
  document.getElementById('pg_html').value = pg.html || '';
  toggleHtmlWrap();
  document.getElementById('overlay').classList.add('show');
}

function toggleHtmlWrap(){
  const tipo = document.getElementById('pg_tipo').value;
  document.getElementById('pg_html_wrap').style.display = tipo === 'html' ? 'flex' : 'none';
}
document.getElementById('pg_tipo').addEventListener('change', toggleHtmlWrap);

function fecharModal(){
  document.getElementById('overlay').classList.remove('show');
}

function salvarPagina(){
  const slug = document.getElementById('pg_slug').value.trim().toLowerCase().replace(/[^a-z0-9-]/g,'-');
  const titulo = document.getElementById('pg_titulo').value.trim();

  if(!slug || !titulo){
    alert('Preencha slug e título.');
    return;
  }

  const duplicado = D.paginas.findIndex((p,i) => p.slug === slug && i !== paginaEmEdicao);
  if(duplicado >= 0){
    alert('Já existe uma página com esse slug.');
    return;
  }

  const nova = {
    slug, titulo,
    icone: document.getElementById('pg_icone').value.trim() || '📄',
    descricao: document.getElementById('pg_descricao').value.trim(),
    tipo: document.getElementById('pg_tipo').value,
    ordem: Number(document.getElementById('pg_ordem').value) || 99,
    publicada: document.getElementById('pg_publicada').value === 'true',
    html: document.getElementById('pg_html').value
  };

  if(paginaEmEdicao !== null){
    D.paginas[paginaEmEdicao] = nova;
    toast('✅ Página atualizada');
  } else {
    D.paginas.push(nova);
    toast('✅ Página criada');
  }

  fecharModal();
  renderPaginas(); renderStats();
}

function excluirPagina(idx){
  if(!confirm('Excluir esta página?')) return;
  D.paginas.splice(idx, 1);
  renderPaginas(); renderStats();
  toast('Página removida.');
}

// ============================================================
// CONTEÚDO PROGRAMÁTICO
// ============================================================
function renderConteudo(){
  const el = document.getElementById('f_conteudo');
  el.value = D.conteudo || '';
  el.oninput = () => { D.conteudo = el.value; };
}

// ============================================================
// SIGAA
// ============================================================
function renderSigaa(){
  const S = D.site;
  const mapa = {
    f_inscTitulo:'inscTitulo', f_inscTexto:'inscTexto',
    f_linkCadastro:'linkCadastro', f_linkVideo:'linkVideo'
  };
  Object.entries(mapa).forEach(([id, k]) => {
    const el = document.getElementById(id);
    if(el){
      el.value = S[k] ?? '';
      el.oninput = () => { S[k] = el.value; };
    }
  });
}

// ============================================================
// ESTATÍSTICAS
// ============================================================
function renderStats(){
  const totalAulas = D.eventos.filter(e => ['inicio','aula','fim'].includes(e.tipo)).length;
  const totalMeet = D.eventos.filter(e => e.tipo === 'meet').length;
  const totalAval = D.eventos.filter(e => e.tipo === 'avaliacao').length;
  const paginasPub = D.paginas.filter(p => p.publicada !== false).length;
  const paginasRasc = D.paginas.filter(p => p.publicada === false).length;
  const cargaTotal = D.eventos.reduce((s,e) => s + (Number(e.carga)||0), 0);

  const cards = [
    {label:'Aulas',              valor: totalAulas,        cor:'#2563EB'},
    {label:'Encontros Meet',     valor: totalMeet,         cor:'#7C3AED'},
    {label:'Avaliações',         valor: totalAval,         cor:'#F97316'},
    {label:'Carga total',        valor: cargaTotal + 'h',  cor:'#16A34A'},
    {label:'Páginas publicadas', valor: paginasPub,        cor:'#0D9488'},
    {label:'Rascunhos',          valor: paginasRasc,       cor:'#FACC15'}
  ];

  document.getElementById('stats').innerHTML = cards.map(c => `
    <div class="stat-card" style="border-left-color:${c.cor};">
      <div class="label">${c.label}</div>
      <div class="valor">${c.valor}</div>
    </div>
  `).join('');
}

// ============================================================
// PUBLICAR (baixar dados.json)
// ============================================================
function publicar(){
  const json = JSON.stringify(D, null, 2);
  const blob = new Blob([json], {type:'application/json'});
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = 'dados.json';
  a.click();
  URL.revokeObjectURL(url);
  toast('📤 dados.json baixado! Suba no GitHub.', 4000);
}

// ============================================================
// INICIALIZAÇÃO
// ============================================================
document.addEventListener('DOMContentLoaded', () => {
  carregarDados();
});
</script>
</body>
</html>
